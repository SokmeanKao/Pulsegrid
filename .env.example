# Example env for Pulsegrid Monitor (copy to .env — gitignored via .env.*)
#
# Browser WebSocket URL (use the IP/hostname clients will open):
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws/metrics
NEXT_PUBLIC_API_URL=http://localhost:8080
#
# Agent Gateway advertise host (shown in Add Agent install commands):
GATEWAY_ADVERTISE_HOST=localhost
GATEWAY_PORT=50051
#
# POSTGRES_PASSWORD=pulsegrid
# BACKEND_PORT=8080
# DASHBOARD_PORT=3000
# POSTGRES_PORT=5432
#
# Place TLS material in ./certs (scripts/generate-monitor-certs.ps1)
